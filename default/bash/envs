# Editor used by CLI
export SUDO_EDITOR="$EDITOR"
export BAT_THEME="Catppuccin Mocha"

# Color man pages with bat
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Duplicated from .config/uwsm/env so SSH works too
export NIRAKASE_PATH=$HOME/.local/share/nirakase
export PATH=$NIRAKASE_PATH/local/bin:$PATH:$HOME/.local/bin
export PROTON_PASS_KEY_PROVIDER="keyring"
export PROTON_PASS_LINUX_KEYRING="dbus"
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/proton-pass-agent.socket"
