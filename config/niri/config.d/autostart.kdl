// --- Nirakase: Startup Processes (Autostart) ---
// Note: Core daemons (Quickshell, awww, proton-pass-agent) are managed as systemd user services.

// Export session environment to D-Bus/systemd, start and unlock GNOME Keyring (required for greetd autologin),
// and start the Proton Pass SSH agent once the keyring is unlocked.
spawn-sh-at-startup "uwsm-app -- sh -c 'dbus-update-activation-environment --systemd --all && gnome-keyring-daemon --start --components=pkcs11,secrets >/dev/null && (secret-tool lookup unlock-keyring dummy >/dev/null 2>&1 || true) && systemctl --user start proton-pass-agent.service'"

// Restore saved multi-monitor profile for the currently connected display topology
spawn-sh-at-startup "python3 \"$HOME/.config/quickshell/scripts/display-manager.py\" restore >/dev/null 2>&1 || true"

// Set default wallpaper on the first login of a new installation
spawn-sh-at-startup "if [ -z \"$(ls -A \"$HOME/.cache/awww\" 2>/dev/null)\" ]; then (sleep 2 && uwsm-app -- ~/.local/share/nirakase/local/bin/nirakase-wallpaper ~/.local/share/nirakase/wallpapers/wallpaper.png); fi"
