// --- Nirakase: Startup Processes (Autostart) ---
// Note: Core daemons (Quickshell, awww, proton-pass-agent) are managed as systemd user services.

spawn-sh-at-startup "uwsm-app -- dbus-update-activation-environment --systemd --all"

// Set default wallpaper on the first login of a new installation
spawn-sh-at-startup "if [ -z \"$(ls -A \"$HOME/.cache/awww\" 2>/dev/null)\" ]; then (sleep 2 && uwsm-app -- ~/.local/share/nirakase/local/bin/nirakase-wallpaper ~/.local/share/nirakase/wallpapers/wallpaper.png); fi"
