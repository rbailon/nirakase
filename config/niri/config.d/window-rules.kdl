// --- Nirakase: Window Rules ---

// ---------------------------------------------------------
// 1. NIRAKASE ECOSYSTEM RULES (Terminal Scripts)
// ---------------------------------------------------------
window-rule {
    match app-id=r#"^org\.nirakase\..*"#

    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.5; }
}

// ---------------------------------------------------------
// 2. DEFAULT FLOATING WINDOWS
// ---------------------------------------------------------
window-rule {
    match app-id="org.gnome.Calculator"
    match app-id="nm-connection-editor"       // Network editor
    match app-id="satty"                      // Screenshot annotation tool
    match app-id="nm-openconnect-auth-dialog" // Authenticator from NetworkManager OpenConnect
    
    // Dialog windows requesting confirmation or saving files
    match title="^Open File$"
    match title="^Save File$"
    match title="^Choose Files$"

    match app-id="xdg-desktop-portal-gtk"
    match app-id="xdg-desktop-portal-gnome" // "Save File" windows
    
    open-floating true
    open-on-workspace "current"
}

// ---------------------------------------------------------
// 3. CUSTOM SIZES
// ---------------------------------------------------------
window-rule {
    match app-id=r#"^(firefox|brave-browser|google-chrome|zen)"#
    
    default-column-width { proportion 0.7; }  // Column at 70% of screen width
}

// ---------------------------------------------------------
// 4. PRIVACY AND SECURITY RULES
// ---------------------------------------------------------
// Prevents sensitive applications from being visible during screen sharing
window-rule {
    match app-id=r#"(?i)(bitwarden|1password|keepassxc|proton[- ]?pass)"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    
    block-out-from "screen-capture"
}


// ---------------------------------------------------------
// 5. GLOBAL RULE
// ---------------------------------------------------------
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// Inactive windows
window-rule {
    match is-active=false
    opacity 0.95
}


// ---------------------------------------------------------
// 6. OTHERS
// ---------------------------------------------------------
// Open the Firefox / Zen Browser picture-in-picture player as floating by default.
window-rule {
    match app-id=r#"(firefox|zen)$"# title="^Picture-in-Picture$"
    open-floating true
}
