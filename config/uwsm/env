# ~/.local/share/nirakase/config/uwsm/env

# --- Wayland Base Variables ---
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=niri
export XDG_SESSION_DESKTOP=niri

# --- Force applications to use native Wayland ---
export MOZ_ENABLE_WAYLAND=1         # Firefox
export QT_QPA_PLATFORM="wayland;xcb" # Qt Apps (KDE/CachyOS)
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GDK_BACKEND="wayland,x11"    # GTK Apps (GNOME)
export OZONE_PLATFORM_HINT=auto     # Electron-based apps (VSCode, Discord, etc.)

export CLUTTER_BACKEND=wayland
export SDL_VIDEODRIVER=wayland

# --- SSH Agent Configuration (Proton Pass CLI) ---
# export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/proton-pass-agent.socket"


# Desktop Theming & Assets (Yaru theme matching)
#export GTK_THEME=Yaru-dark
#export XCURSOR_THEME=Yaru
#export XCURSOR_SIZE=24

export NIRAKASE_PATH=$HOME/.local/share/nirakase
export PATH=$NIRAKASE_PATH/local/bin:$PATH:$HOME/.local/bin

export TERMINAL=xdg-terminal-exec
export EDITOR=nvim

# Activate mise if present on the system
# command -v mise >/dev/null 2>&1 && eval "$(mise activate bash --shims)"
