#!/usr/bin/env bash
# ==============================================================================
# Nirakase: nirakase-launch-webapp
# Description: Launches a web application in borderless application mode.
# License: MIT License | Copyright (c) 2026-present rbailon
# ==============================================================================

set -euo pipefail

# Check arguments
if [ -z "${1:-}" ]; then
    echo "Usage: nirakase-launch-webapp <URL>" >&2
    exit 1
fi

URL="$1"

if ! command -v brave-origin >/dev/null 2>&1; then
    notify-send "Nirakase WebApp" "brave-origin is not installed. Please install brave-origin-bin." -u critical 2>/dev/null || true
    echo "Error: brave-origin is required to launch WebApps in --app mode." >&2
    exit 1
fi

# Bypass 'uwsm app' to prevent systemd scope isolation from breaking
# the browser's single-instance IPC mechanism.
exec brave-origin --app="$URL"
