#!/usr/bin/env bash
# ~/.local/share/nirakase/local/bin/pass-cli
#
# Transparent Nirakase wrapper around the real Proton Pass CLI binary.
# $NIRAKASE_PATH/local/bin precedes the rest of PATH, so every 'pass-cli' call goes
# through here and is forwarded unchanged, except:
#
#   pass-cli login   -> stops proton-pass-agent.service, runs the real login and,
#                       if it succeeds, starts the agent (SSH socket ready).
#   pass-cli logout  -> stops proton-pass-agent.service, then runs the real logout.
#
# This guarantees no background pass-cli process touches the session while you
# log in (which previously wiped ~/.local/share/proton-pass-cli/.session).

AGENT_UNIT="proton-pass-agent.service"
AGENT_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/proton-pass-agent.socket"

# Locate the real pass-cli binary, skipping this wrapper
self="$(readlink -f "${BASH_SOURCE[0]}")"
real=""
IFS=: read -ra path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}" "$HOME/.local/bin" /usr/local/bin /usr/bin; do
    candidate="$dir/pass-cli"
    [ -x "$candidate" ] || continue
    [ "$(readlink -f "$candidate")" = "$self" ] && continue
    real="$candidate"
    break
done

if [ -z "$real" ]; then
    echo "pass-cli: real Proton Pass CLI binary not found" >&2
    exit 127
fi

# Help/version requests are always forwarded untouched
for arg in "$@"; do
    case "$arg" in -h|--help|-V|--version) exec "$real" "$@" ;; esac
done

agent_stop() {
    systemctl --user stop "$AGENT_UNIT" >/dev/null 2>&1 || true
}

case "${1:-}" in
    login)
        agent_stop
        "$real" "$@"
        rc=$?
        if [ "$rc" -eq 0 ]; then
            systemctl --user reset-failed "$AGENT_UNIT" >/dev/null 2>&1 || true
            if systemctl --user start "$AGENT_UNIT"; then
                for _ in $(seq 1 40); do
                    [ -S "$AGENT_SOCK" ] && break
                    sleep 0.25
                done
                if [ -S "$AGENT_SOCK" ]; then
                    echo "[nirakase] Proton Pass SSH agent ready: $AGENT_SOCK" >&2
                else
                    echo "[nirakase] SSH agent did not create its socket. Check: journalctl --user -u $AGENT_UNIT" >&2
                fi
            fi
        fi
        exit "$rc"
        ;;
    logout)
        agent_stop
        exec "$real" "$@"
        ;;
    *)
        exec "$real" "$@"
        ;;
esac
