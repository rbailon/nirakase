#!/usr/bin/env bash
# ==============================================================================
# Nirakase: nirakase-capture-screenshot
# Description: Unified screenshot utility supporting region, window, and monitor captures.
# License: MIT License | Copyright (c) 2026-present rbailon
# ==============================================================================

set -uo pipefail

# Define screenshot target directory
SCREENSHOT_DIR="${HOME}/Pictures/Screenshots"

# Ensure the directory exists
if [ ! -d "$SCREENSHOT_DIR" ]; then
    mkdir -p "$SCREENSHOT_DIR"
fi

# Define unique timestamped path (used only if the user chooses to save to disk)
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
SCREENSHOT_PATH="${SCREENSHOT_DIR}/Screenshot_${TIMESTAMP}.png"

# Create temporary file in RAM (tmpfs in XDG_RUNTIME_DIR, mode 0600) and ensure cleanup on exit
TMP_SHOT=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/nirakase-shot-XXXXXX.png")
trap 'rm -f "$TMP_SHOT"' EXIT INT TERM

# Check dependencies
if ! command -v grim >/dev/null 2>&1; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "Nirakase Screenshot" "Error: 'grim' is not installed."
    fi
    exit 1
fi

MODE="${1:-area}"
NEEDS_WAIT=0

# Optional delay only when requested (e.g. when launched from a closing TUI menu)
if [[ "${2:-}" == "--delay" ]]; then
    sleep 0.2
fi

case "$MODE" in
    window)
        # Capture the focused window. Fallback to slurp interactive selection if Niri IPC is unavailable.
        if command -v niri >/dev/null 2>&1 && niri msg focused-window >/dev/null 2>&1; then
            rm -f "$TMP_SHOT"
            if ! niri msg action screenshot-window --path "$TMP_SHOT"; then
                exit 1
            fi
            NEEDS_WAIT=1
        else
            if command -v slurp >/dev/null 2>&1; then
                if ! grim -g "$(slurp)" "$TMP_SHOT"; then
                    exit 0
                fi
            else
                exit 1
            fi
        fi
        ;;

    monitor)
        # Capture the focused screen/monitor. Fallback to standard grim full-screen capture if Niri IPC is unavailable.
        if command -v niri >/dev/null 2>&1 && niri msg focused-output >/dev/null 2>&1; then
            rm -f "$TMP_SHOT"
            if ! niri msg action screenshot-screen --path "$TMP_SHOT"; then
                exit 1
            fi
            NEEDS_WAIT=1
        else
            if ! grim "$TMP_SHOT"; then
                exit 1
            fi
        fi
        ;;

    area|*)
        # Interactive region capture
        if ! command -v slurp >/dev/null 2>&1; then
            if command -v notify-send >/dev/null 2>&1; then
                notify-send -u critical "Nirakase Screenshot" "Error: 'slurp' is not installed."
            fi
            exit 1
        fi

        # Run slurp to select region and grim to grab the image synchronously into RAM
        if ! grim -g "$(slurp)" "$TMP_SHOT"; then
            # If slurp is cancelled (e.g. via ESC), exit quietly
            exit 0
        fi
        ;;
esac

# Wait for asynchronous Niri compositor screenshot write if needed (up to 5 seconds, 20ms intervals)
if [ "$NEEDS_WAIT" -eq 1 ]; then
    TIMEOUT=250
    while [ ! -s "$TMP_SHOT" ]; do
        sleep 0.02
        TIMEOUT=$((TIMEOUT - 1))
        if [ "$TIMEOUT" -le 0 ]; then
            if command -v notify-send >/dev/null 2>&1; then
                notify-send -u critical "Nirakase Screenshot" "Error: The screenshot save operation timed out."
            fi
            exit 1
        fi
    done
fi

# Ensure the image was successfully captured and written
if [ ! -s "$TMP_SHOT" ]; then
    exit 1
fi

# Launch Satty editor if available for annotations (reads from RAM; only saves/copies what the user confirms)
if command -v satty >/dev/null 2>&1; then
    satty --filename "$TMP_SHOT" \
          --output-filename "$SCREENSHOT_PATH" \
          --early-exit \
          --copy-command 'wl-copy'
else
    # Fallback when Satty is not installed: persist to disk and copy to clipboard
    cp "$TMP_SHOT" "$SCREENSHOT_PATH"
    if command -v wl-copy >/dev/null 2>&1; then
        wl-copy < "$SCREENSHOT_PATH"
    fi
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Screenshot Saved" "Screenshot saved in Pictures/Screenshots" -i camera -t 3000
    fi
fi
