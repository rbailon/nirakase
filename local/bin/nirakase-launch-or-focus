#!/bin/bash
# ==============================================================================
# Nirakase: nirakase-launch-or-focus
# Description: Launches an application or focuses its window if already running.
# License: MIT License | Copyright (c) 2026-present rbailon
# ==============================================================================

export PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd):$PATH"

if (($# == 0)); then
  echo "Usage: nirakase-launch-or-focus [window-pattern] [launch-command...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift

if (($# == 0)); then
  LAUNCH_CMD=(uwsm app -- "$WINDOW_PATTERN")
elif (($# == 1)) && [[ "$1" == *" "* ]]; then
  read -r -a LAUNCH_CMD <<< "$1"
else
  LAUNCH_CMD=("$@")
fi

WINDOW_ID=$(niri msg -j windows | jq -r --arg p "$WINDOW_PATTERN" '
    ($p | gsub("([.^$*+?()\\[\\]{}|\\\\])"; "\\\\\\1")) as $escaped |
    .[] | select(
        ((.app_id // "") | ascii_downcase) == ($p | ascii_downcase) or
        ((.app_id // "") | test("(^|\\b)" + $escaped + "($|\\b)"; "i")) or
        ((.title // "")  | test("(^|\\b)" + $escaped + "($|\\b)"; "i"))
    ) | .id
  ' | head -n1)

if [[ -n $WINDOW_ID ]]; then
  niri msg action focus-window --id "$WINDOW_ID" >/dev/null 2>&1
else
  exec setsid "${LAUNCH_CMD[@]}"
fi
