#!/usr/bin/env bash
# ==============================================================================
# Nirakase: Wallpaper selector indexer and launcher
# ==============================================================================
set -euo pipefail

# Allow only a single background-switcher instance at a time
if pgrep -u "$USER" -f "quickshell.*background-switcher\.qml" >/dev/null 2>&1; then
    exit 0
fi

WALLPAPERS_DIR="$HOME/.local/share/nirakase/wallpapers"
CACHE_DIR="$HOME/.cache/nirakase/image-selector"
mkdir -p "$CACHE_DIR/thumbs"

[[ -d "$WALLPAPERS_DIR" ]] || exit 1

# Resolve current wallpaper path (dereferencing symlinks)
raw_bg=$(awww query 2>/dev/null | grep -oP 'image:\s*\K\S+' | head -n1 || echo "")
current_bg=$(realpath "$raw_bg" 2>/dev/null || echo "$raw_bg")
export NIRAKASE_CURRENT_WALLPAPER="$current_bg"

# Compute wallpaper directory signature (excluding default symlink)
sig=$(find -L "$WALLPAPERS_DIR" -maxdepth 1 -type f ! -name "wallpaper.png" \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) -printf "%p:%T@\n" | sort | md5sum | cut -d' ' -f1)
index_file="$CACHE_DIR/index.json"
sig_file="$CACHE_DIR/signature"

if [[ ! -f "$sig_file" || "$sig" != "$(cat "$sig_file" 2>/dev/null)" || ! -f "$index_file" ]]; then
    # Enumerate images excluding default symlink
    mapfile -d $'\0' images < <(find -L "$WALLPAPERS_DIR" -maxdepth 1 -type f ! -name "wallpaper.png" \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) -print0 | sort -z)
    
    images_array=()
    for img in "${images[@]}"; do
        base_name=$(basename "$img")
        formatted_name=$(echo "${base_name%.*}" | tr '_-' ' ' | sed -E 's/\b(.)/\U\1/g')
        img_hash=$(printf "%s" "$img" | md5sum | cut -d' ' -f1)
        thumb_path="$CACHE_DIR/thumbs/$img_hash.jpg"

        # Generate thumbnail if missing or modified
        if [[ ! -f "$thumb_path" || "$img" -nt "$thumb_path" ]]; then
            magick "$img[0]" -auto-orient -resize '640x360^' -gravity center -extent '640x360' -quality 75 "$thumb_path" 2>/dev/null || cp "$img" "$thumb_path"
        fi

        images_array+=("{\"path\":\"$img\",\"thumb\":\"$thumb_path\",\"name\":\"$formatted_name\"}")
    done

    printf '%s\n' "[$(IFS=,; echo "${images_array[*]}")]" > "$index_file"
    echo "$sig" > "$sig_file"
fi

# Launch wallpaper switcher UI on demand
exec quickshell -p "$HOME/.config/quickshell/background-switcher.qml"
